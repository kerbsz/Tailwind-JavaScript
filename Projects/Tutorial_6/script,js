//-----------------------GETTERS AND SETTERS-------------------------//
class BankAccount {
  #balance = 0; // True private property

    constructor(initialDeposit) {
        this.balance = initialDeposit; // Triggers the setter
    }

    // Getter
    get balance() {
        return `$${this.#balance.toFixed(2)}`;
    }

    // Setter with data validation
    set balance(amount) {
        if (amount >= 0) {
        this.#balance = amount;
        } else {
        console.error("Negative balances are not allowed!");
        }
    }
}

// Usage
const myAccount = new BankAccount(100);
//console.log(myAccount.balance); // $100.00
myAccount.balance = 250;        // Updates private state via setter
//console.log(myAccount.balance); // $250.00

