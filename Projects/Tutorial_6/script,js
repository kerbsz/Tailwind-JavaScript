//---------------SUPER key word for the parent class---------/
class Animal{
    constructor(name,age){
        this.name = name;
        this.age = age;
    }

    likestoEat(faveFood){
        console.log(`${this.name.charAt(0).toUpperCase() + this.name.slice(1)} likes to eat ${faveFood}`)
    }
}

class Dog extends Animal{
    constructor(name,age,runspeed,faveFood){
        super(name,age);
        this.runspeed = runspeed;
        this.faveFood = faveFood;
    }

    introduce(){
        console.log(`
                    I'm a Dog named ${this.name}
                    I'm ${this.age} years old and
                    I can run at ${this.runspeed} mph`);
    }
    favFood(){
        super.likestoEat(this.faveFood)
    }

}
class Fish extends Animal{
    constructor(name,age,swimspeed,faveFood){
        super(name,age);
